<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/UI%20Toolkit/GameUI/PlayerHUD.uss?fileID=7433441132597879392&amp;guid=89bbe73027f904b8da50bf55484c285f&amp;type=3#PlayerHUD"/>
    <ui:VisualElement name="weapon-info-container" picking-mode="Ignore">
        <ui:Label name="weapon-type-label" text="Weapon Name" enabled="true" style="display: none;"/>
        <ui:Label name="reloading-label" text="RELOADING"/>
        <ui:VisualElement name="weapon-icon" style="display: none;"/>
            <ui:Label name="selected-building-label" text="" style="display: none;"/>
            <ui:Label name="buildings-remaining-label" text="Buildings Remaining: 3/3" style="display: none;"/>
        <ui:VisualElement name="ammo-container">
            <ui:Label name="ammo-label" text="0 / 0"/>
            <ui:Label name="ammo-reserve-label" text="Reserve: &#8734;" style="display: none;"/>
            <ui:ProgressBar value="22" title="AMMO" name="player-ammo-bar" class="kits-progress-bar kits-ammo-bar"/>
        </ui:VisualElement>
    </ui:VisualElement>
    <ui:VisualElement name="health-info-container" picking-mode="Ignore">
        <ui:Label name="lives-remaining-label" text="Lives: " style="display: none;"/>
        <ui:ProgressBar value="63.8" title="HEALTH" name="player-health-bar" class="kits-progress-bar"/>
        <ui:ProgressBar name="player-stamina-bar" low-value="0" high-value="100" value="100" class="kits-progress-bar" style="display: none;"/>
    </ui:VisualElement>
    <ui:VisualElement name="reticle-container" picking-mode="Ignore">
        <ui:VisualElement name="player-reticle" picking-mode="Ignore"/>
        <ui:VisualElement name="hit-marker" picking-mode="Ignore">
            <ui:VisualElement name="hit-marker-bar-a" picking-mode="Ignore"/>
            <ui:VisualElement name="hit-marker-bar-b" picking-mode="Ignore"/>
            <ui:VisualElement name="hit-marker-bar-c" picking-mode="Ignore"/>
            <ui:VisualElement name="hit-marker-bar-d" picking-mode="Ignore"/>
        </ui:VisualElement>  
        <ui:VisualElement name="tutorial-panel" style="position: absolute; top: 15%; left: 50%; translate: -50% 0; width: 520px; padding: 20px; background-color: rgba(10, 15, 25, 0.9); border-width: 2px; border-color: rgb(255, 255, 255); border-top-left-radius: 10px; border-top-right-radius: 10px; border-bottom-left-radius: 10px; border-bottom-right-radius: 10px; display: none;">
            <ui:Label name="tutorial-title" text="Build Mode" style="font-size: 30px; -unity-font-style: bold; color: rgb(131, 180, 222); -unity-text-align: middle-center; margin-bottom: 10px;" />
            <ui:Label name="tutorial-description" text="Use scroll wheel to change between build items!" style="font-size: 22px; color: white; -unity-text-align: middle-center; white-space: normal;" />
            <ui:Label name="tutorial-description" text="Place them wisely. You are only allowed 3!" style="font-size: 22px; color: white; -unity-text-align: middle-center; white-space: normal;" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
